APP_NAME="User Additions"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Johannesburg

# SUGGESTION FROM ONLINE ENCRYPTION OF ID NUMBER
# Secret used to HMAC-hash ID numbers (and IPs for rate limiting). 32+ random bytes.
# Generate:  php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
# The dummy rows in database/schema.sql were hashed with THIS dev key. Changing the
# key makes existing hashes un-searchable by ID number, so set it once per environment.
APP_KEY=base64:p0tFrG1hJb7/byliSoM+pWryGoea23TEFjk/Cqa+HDU=

ENCRYPTION_KEY=12345678901234561234567890123456

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=connectionyou
DB_USER=root
DB_PASS=12345678
